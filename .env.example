# Copy to .env and replace token with a unique random value of >=32 characters.
MCP_TOKEN=
DEMO_MODE=true
OBSERVE_ONLY=true
ENABLE_EV_WRITE=false
LOXONE_WATCHDOG_CONFIRMED=false
MCP_URL=http://127.0.0.1:8080/mcp
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","qbox:*"]
LOXONE_URL=https://miniserver.local
LOXONE_USERNAME=
LOXONE_PASSWORD=
LOXONE_ALLOW_HTTP=false
# Simple input/output names or UUIDs. Values must already use W and percent.
LOXONE_GRID_POWER=
LOXONE_PV_POWER=
LOXONE_BATTERY_SOC=
LOXONE_BATTERY_POWER=
LOXONE_EV_POWER=
LOXONE_EV_LIMIT_INPUT=
EV_MAX_POWER_W=11000
WRITE_COOLDOWN_SECONDS=60
SNAPSHOT_MAX_AGE_SECONDS=30
REQUEST_TIMEOUT_SECONDS=5
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
REASONING_INTERVAL_SECONDS=300
HISTORY_PATH=/data/history.sqlite3
HISTORY_MAX_ROWS=10000

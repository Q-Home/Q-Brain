#!/bin/bash
set -eu
folder="${3:?Missing plugin folder}"
case "$folder" in ''|*[!a-zA-Z0-9_-]*) exit 2 ;; esac
controller="/usr/local/lib/qbrain/$folder/control.py"
if [ -f "$controller" ]; then
  "$controller" uninstall || { echo '<ERROR> Q-Brain cleanup blocked. Finish the active operation or restore Docker, then retry uninstall.'; exit 2; }
fi
echo '<OK> Q-Brain services removed. Configuration and Docker data volumes retained for recovery.'
